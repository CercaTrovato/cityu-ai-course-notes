       "mean      5.843333\n",
       "median    5.800000\n",
       "mode      5.000000\n",
       "std       0.828066\n",
       "min       4.300000\n",
       "max       7.900000\n",
       "Q1        5.100000\n",
       "Q3        6.400000\n",
       "range     3.600000\n",
       "IQR       1.300000\n",
       "skew      0.314911\n",
       "kurt     -0.552064\n",
