        "I"
      ],
      [
        "C5",
        "J"
      ]
    ]
  },
  {
    "kind": "paragraph",
    "text": "Narrative description:"
  },
  {
    "kind": "paragraph",
    "text": "Cashier F takes cares of CashR# 1, 3 and  Cashier J takes care of CashR# 2, 4. "
  },
  {
    "kind": "table",
    "rows": [
      [
        "CashR#",
        "Amount",
