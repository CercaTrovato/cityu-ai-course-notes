digraph CityUModel {
graph [rankdir=LR, nodesep=0.65, ranksep=1.6, splines=polyline, pad=0.7, bgcolor="white", outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=16];
edge [dir=none, fontname="Arial", fontsize=14, labelfontname="Arial", labelfontsize=16, color="#52616b", labeldistance=2.6, labelangle=28, penwidth=1.3];
graph [label="AC6761 Case 5 Revenue Process Core REA Model - all attributes\nSource: Case 5.docx and the one-page official hand-drawn Solution of Case 5.pdf. Layout positions aid reading and do not imply sequence or causality.",labelloc=b,fontname="Arial",fontsize=13];
"surfboard_inventory" [id="node-surfboard_inventory",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#52616b"><TR><TD BGCOLOR="#e9f3fc" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;Resource&gt;&gt;</FONT><BR/><B>Surfboard Inventory</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Surfboard# (PK)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Surfboard description</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Surfboard sell-price</TD></TR></TABLE>>];
"cash_account" [id="node-cash_account",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#52616b"><TR><TD BGCOLOR="#e9f3fc" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;Resource&gt;&gt;</FONT><BR/><B>Cash Account</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Cash Account# (PK)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Cash account type</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Bank name</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Cash balance</TD></TR></TABLE>>];
"sale" [id="node-sale",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#52616b"><TR><TD BGCOLOR="#fff2dc" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;EconomicDecrement&gt;&gt;</FONT><BR/><B>Sale</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Sale# (PK)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Sale total amount</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Sale no. of items</TD></TR></TABLE>>];
"cash_receipt" [id="node-cash_receipt",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#52616b"><TR><TD BGCOLOR="#e8f5ed" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;EconomicIncrement&gt;&gt;</FONT><BR/><B>Cash Receipt</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Cash receipt# (PK)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Cash receipt total amount</TD></TR></TABLE>>];
"salesperson" [id="node-salesperson",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#52616b"><TR><TD BGCOLOR="#f3eefb" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;InternalAgent&gt;&gt;</FONT><BR/><B>Salesperson</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Salesperson# (PK)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Salesperson name</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Salesperson commission rate</TD></TR></TABLE>>];
"customer" [id="node-customer",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#52616b"><TR><TD BGCOLOR="#f1f3f5" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;ExternalAgent&gt;&gt;</FONT><BR/><B>Customer</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Customer# (PK)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Customer name</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Customer account receivable</TD></TR></TABLE>>];
"cashier" [id="node-cashier",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#52616b"><TR><TD BGCOLOR="#f3eefb" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;InternalAgent&gt;&gt;</FONT><BR/><B>Cashier</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Cashier# (PK)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Cashier name</TD></TR></TABLE>>];
subgraph column_0 { rank=same; "surfboard_inventory"; "cash_account"; }
subgraph column_1 { rank=same; "sale"; "cash_receipt"; }
subgraph column_2 { rank=same; "salesperson"; "customer"; "cashier"; }
"surfboard_inventory" -> "cash_account" [style=invis,weight=100];
"sale" -> "cash_receipt" [style=invis,weight=100];
"salesperson" -> "customer" [style=invis,weight=100];
"customer" -> "cashier" [style=invis,weight=100];
"surfboard_inventory" -> "sale" [id="edge-stockflow1",taillabel="1..*",headlabel="0..1",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD>Stockflow1</TD></TR></TABLE>>,constraint=true,minlen=1];
"cash_account" -> "cash_receipt" [id="edge-stockflow2",taillabel="1..1",headlabel="0..*",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD>Stockflow2</TD></TR></TABLE>>,constraint=true,minlen=1];
"sale" -> "cash_receipt" [id="edge-duality",taillabel="0..*",headlabel="0..*",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD>Duality</TD></TR><TR><TD>Cash receipt amount applied to sale</TD></TR></TABLE>>,constraint=false,minlen=1];
"sale" -> "salesperson" [id="edge-participation1",taillabel="0..*",headlabel="1..1",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD>Participation1</TD></TR></TABLE>>,constraint=true,minlen=1];
"sale" -> "customer" [id="edge-participation2",taillabel="0..*",headlabel="1..1",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD>Participation2</TD></TR></TABLE>>,constraint=true,minlen=1];
"cash_receipt" -> "customer" [id="edge-participation3",taillabel="0..*",headlabel="0..1",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD>Participation3</TD></TR></TABLE>>,constraint=true,minlen=1];
"cash_receipt" -> "cashier" [id="edge-participation4",taillabel="0..*",headlabel="1..1",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD>Participation4</TD></TR></TABLE>>,constraint=true,minlen=1];
"salesperson" -> "customer" [id="edge-assignment",taillabel="1..1",headlabel="1..*",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD>Assignment</TD></TR></TABLE>>,constraint=false,minlen=1];
}
