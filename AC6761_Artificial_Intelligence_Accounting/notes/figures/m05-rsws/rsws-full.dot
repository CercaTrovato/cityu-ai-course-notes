digraph CityUModel {
graph [rankdir=LR, nodesep=1.1, ranksep=2.0, splines=polyline, pad=0.7, bgcolor="white", outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=16];
edge [dir=none, fontname="Arial", fontsize=14, labelfontname="Arial", labelfontsize=16, color="#52616b", labeldistance=6.5, labelangle=0, penwidth=1.3];
graph [label="RSWS core acquisition model - all attributes\nBaseline transcription redrawn; no new official-source validation. Overview and full attributes share one JSON.",labelloc=b,fontname="Arial",fontsize=13];
"InventoryType" [id="node-InventoryType",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#52616b"><TR><TD BGCOLOR="#f1f3f5" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;ResourceType&gt;&gt;</FONT><BR/><B>Inventory Type</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Item-id (PK)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Item-desc</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Item-std-cost</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Item-list-price</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Item-qoh</TD></TR></TABLE>>];
"Overhead" [id="node-Overhead",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#52616b"><TR><TD BGCOLOR="#f1f3f5" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;ResourceType&gt;&gt;</FONT><BR/><B>Overhead</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">OH-id (PK)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">OH-desc</TD></TR></TABLE>>];
"Cash" [id="node-Cash",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#52616b"><TR><TD BGCOLOR="#f1f3f5" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;ResourceType&gt;&gt;</FONT><BR/><B>Cash</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">AcctNum (PK)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">AcctType</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">AcctLoc</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">AcctBal</TD></TR></TABLE>>];
"Purchase" [id="node-Purchase",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#52616b"><TR><TD BGCOLOR="#e8f5ed" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;EconomicIncrement&gt;&gt;</FONT><BR/><B>Purchase</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Acq-ID (PK)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Acq-date</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Acq-amt</TD></TR></TABLE>>];
"CashDisbursement" [id="node-CashDisbursement",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#52616b"><TR><TD BGCOLOR="#fff2dc" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;EconomicDecrement&gt;&gt;</FONT><BR/><B>Cash Disbursement</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">CD-id (PK)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">CD-date</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">CD-amt</TD></TR></TABLE>>];
"PurchaseAgent" [id="node-PurchaseAgent",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#52616b"><TR><TD BGCOLOR="#f3eefb" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;InternalAgent&gt;&gt;</FONT><BR/><B>Purchase Agent</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PA-id (PK)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PA-name</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PA-limit</TD></TR></TABLE>>];
"Supplier" [id="node-Supplier",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#52616b"><TR><TD BGCOLOR="#f1f3f5" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;ExternalAgent&gt;&gt;</FONT><BR/><B>Supplier</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">SupNum (PK)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Sup-name</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Sup-add</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Sup-rating</TD></TR></TABLE>>];
"APClerk" [id="node-APClerk",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#52616b"><TR><TD BGCOLOR="#f3eefb" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;InternalAgent&gt;&gt;</FONT><BR/><B>A/P Clerk</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">AP-id (PK)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">AP-name</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">AP-bond</TD></TR></TABLE>>];
"Manager" [id="node-Manager",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#52616b"><TR><TD BGCOLOR="#f3eefb" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;InternalAgent&gt;&gt;</FONT><BR/><B>Manager</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Mgr-id (PK)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Mgr-name</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Mgr-degree</TD></TR></TABLE>>];
subgraph column_0 { rank=same; "InventoryType"; "Overhead"; "Cash"; }
subgraph column_1 { rank=same; "Purchase"; "CashDisbursement"; }
subgraph column_2 { rank=same; "PurchaseAgent"; "Supplier"; "APClerk"; "Manager"; }
"InventoryType" -> "Overhead" [style=invis,weight=100];
"Overhead" -> "Cash" [style=invis,weight=100];
"Purchase" -> "CashDisbursement" [style=invis,weight=100];
"PurchaseAgent" -> "Supplier" [style=invis,weight=100];
"Supplier" -> "APClerk" [style=invis,weight=100];
"APClerk" -> "Manager" [style=invis,weight=100];
"InventoryType" -> "Purchase" [id="edge-sf1",taillabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>0..*</TD></TR></TABLE>>,headlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>0..*</TD></TR></TABLE>>,label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD>Stockflow1</TD></TR><TR><TD>item-qty-purch</TD></TR><TR><TD>item-unit-cost</TD></TR></TABLE>>,labeldistance=6.5,labelangle=0,constraint=true,minlen=1];
"Overhead" -> "Purchase" [id="edge-sf2",taillabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>0..*</TD></TR></TABLE>>,headlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>0..*</TD></TR></TABLE>>,label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD>Stockflow2</TD></TR><TR><TD>oh-qty-purch</TD></TR></TABLE>>,labeldistance=6.5,labelangle=0,constraint=true,minlen=1];
"Cash" -> "CashDisbursement" [id="edge-sf3",taillabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>1..1</TD></TR></TABLE>>,headlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>0..*</TD></TR></TABLE>>,label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD>Stockflow3</TD></TR></TABLE>>,labeldistance=6.5,labelangle=0,constraint=true,minlen=1];
"Purchase" -> "CashDisbursement" [id="edge-duality",taillabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>0..*</TD></TR></TABLE>>,headlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>0..*</TD></TR></TABLE>>,label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD>Duality</TD></TR><TR><TD>cd-acq-applied</TD></TR></TABLE>>,labeldistance=2.8,labelangle=35,constraint=false,minlen=1];
"Purchase" -> "PurchaseAgent" [id="edge-p1",taillabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>0..*</TD></TR></TABLE>>,headlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>1..1</TD></TR></TABLE>>,label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD>Participation (1)</TD></TR></TABLE>>,labeldistance=6.5,labelangle=0,constraint=true,minlen=1];
"Purchase" -> "Supplier" [id="edge-p2",taillabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>0..*</TD></TR></TABLE>>,headlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>1..1</TD></TR></TABLE>>,label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD>Participation2</TD></TR></TABLE>>,labeldistance=6.5,labelangle=0,constraint=true,minlen=1];
"CashDisbursement" -> "Supplier" [id="edge-p3",taillabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>0..*</TD></TR></TABLE>>,headlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>0..1</TD></TR></TABLE>>,label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD>Participation3</TD></TR></TABLE>>,labeldistance=6.5,labelangle=0,constraint=true,minlen=1];
"CashDisbursement" -> "APClerk" [id="edge-p4",taillabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>0..*</TD></TR></TABLE>>,headlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>1..1</TD></TR></TABLE>>,label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD>Participation4</TD></TR></TABLE>>,labeldistance=6.5,labelangle=0,constraint=true,minlen=1];
"CashDisbursement" -> "Manager" [id="edge-p5",taillabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>0..*</TD></TR></TABLE>>,headlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>1..1</TD></TR></TABLE>>,label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD>Participation5</TD></TR></TABLE>>,labeldistance=6.5,labelangle=0,constraint=true,minlen=1];
}
